{
  "info": {
    "name": "Campus Equipment Booking API",
    "description": "Run requests in order. Requires a running local API and an empty test interval. Create stores bookingId automatically. Delete removes the test booking. Repeated create before delete returns 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8787/api"
    },
    {
      "key": "bookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Equipment — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/equipment"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create booking — 201 (save bookingId)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"eq-1\",\n  \"borrowerName\": \"Postman Student\",\n  \"startAt\": \"2026-10-20T09:00:00.000Z\",\n  \"endAt\": \"2026-10-20T11:00:00.000Z\",\n  \"purpose\": \"Postman API test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set('bookingId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 List bookings — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/bookings"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Get booking — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Overlap — 409",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"eq-1\",\n  \"borrowerName\": \"Postman Student\",\n  \"startAt\": \"2026-10-20T10:00:00.000Z\",\n  \"endAt\": \"2026-10-20T12:00:00.000Z\",\n  \"purpose\": \"Postman API test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 409', () => pm.response.to.have.status(409));",
              "pm.test('JSON error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Unknown equipment — 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"missing\",\n  \"borrowerName\": \"Postman Student\",\n  \"startAt\": \"2026-10-20T09:00:00.000Z\",\n  \"endAt\": \"2026-10-20T11:00:00.000Z\",\n  \"purpose\": \"Postman API test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('JSON error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Reversed time — 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"eq-1\",\n  \"borrowerName\": \"Postman Student\",\n  \"startAt\": \"2026-10-20T11:00:00.000Z\",\n  \"endAt\": \"2026-10-20T09:00:00.000Z\",\n  \"purpose\": \"Postman API test\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('JSON error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Missing field — 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"equipmentId\": \"eq-1\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('JSON error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Patch booking — 200",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/bookings/{{bookingId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"purpose\": \"Updated from Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Delete booking — 204",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Get deleted booking — 404",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/bookings/{{bookingId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('JSON error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
            ]
          }
        }
      ]
    }
  ]
}
